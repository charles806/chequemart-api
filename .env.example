# ── SERVER ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MONGODB ─────────────────────────────────────
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster.mongodb.net/chequemart

# ── POSTGRESQL (Neon) ───────────────────────────
POSTGRES_URI=postgresql://USER:PASS@HOST/chequemart?sslmode=require

# ── JWT ─────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ── PAYSTACK ────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── CLOUDINARY ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── GMAIL SMTP ──────────────────────────────────
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# ── ADMIN ───────────────────────────────────────
ADMIN_EMAIL=admin@chequemart.com

# ── FRONTEND URL (for CORS) ──────────────────────
CLIENT_URL=http://localhost:5173

# ── TERMII (SMS) ────────────────────────────────
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=Chequemart