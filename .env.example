# ── SERVER ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MONGODB ─────────────────────────────────────
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster.mongodb.net/chequemart

# ── POSTGRESQL (Neon) ───────────────────────────
POSTGRES_URI=postgresql://USER:PASS@HOST/chequemart?sslmode=require
# Alias used by the raw-SQL escrow query layer (escrow ledger). Falls back to POSTGRES_URI.
DATABASE_URL=postgresql://USER:PASS@HOST/chequemart?sslmode=require

# ── ESCROW LEDGER ───────────────────────────────
# Commission tiers (naira). Spec defaults: <10k → 0%, 10k–50k → 5%, >50k → 10%
ESCROW_COMMISSION_BELOW_MIN_THRESHOLD=10000
ESCROW_COMMISSION_TIER1_MAX=50000
ESCROW_COMMISSION_TIER_LOW_RATE=5
ESCROW_COMMISSION_TIER_HIGH_RATE=10

# ── JWT ─────────────────────────────────────────
# Short-lived access token secret (default expiry: 15m)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here
# Long-lived refresh token secret (default expiry: 7d)
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here

# ── SERVER-SIDE SESSIONS ────────────────────────
# Session lifetime in days (controls the HttpOnly sid cookie + session TTL)
SESSION_TTL_DAYS=7
# Name of the opaque session cookie (scoped to /api, HttpOnly)
SESSION_COOKIE_NAME=sid

# ── PAYSTACK ────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── CLOUDINARY ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── GMAIL SMTP ──────────────────────────────────
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# ── ADMIN ───────────────────────────────────────
ADMIN_EMAIL=admin@chequemart.com

# ── FRONTEND URL (for CORS) ──────────────────────
CLIENT_URL=http://localhost:5173

# ── CRON (escrow auto-release) ──────────────────
# Sent in the `x-cron-api-key` header by the Vercel cron job.
CRON_API_KEY=generate_a_long_random_string

# ── TERMII (SMS) ────────────────────────────────
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=Chequemart