{
  "name": "chequemart-backend",
  "version": "1.0.0",
  "description": "Chequemart Multi-Vendor E-Commerce Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:status": "npx sequelize-cli db:migrate:status",
    "db:validate": "node src/scripts/apply-mongo-validation.js",
    "db:validate:apply": "node src/scripts/apply-mongo-validation.js --apply",
    "db:audit:size": "node src/scripts/audit-doc-sizes.js",
    "db:indexes": "node src/scripts/verify-indexes.js",
    "db:indexes:apply": "node src/scripts/verify-indexes.js --apply",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "dependencies": {
    "@sentry/node": "^10.50.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "connect-timeout": "^1.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "file-type": "^22.0.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^2.2.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "rate-limit-mongo": "^2.3.2",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.12.2",
    "uuid": "^14.0.1",
    "validator": "^13.15.26"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcryptjs": "^2.4.6",
    "eslint": "^9.39.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2"
  },
  "_phase2Dependencies": {
    "_note": "Install these when Phase 2 begins",
    "twilio": "^5.2.2"
  }
}
